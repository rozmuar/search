# Environment variables for development
ENV=development
DEBUG=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=search_service
DB_USER=search_user
DB_PASSWORD=search_pass

# API
API_HOST=0.0.0.0
API_PORT=8000

# SMTP - письма клиентам про биллинг (напоминание за 7 дней, приостановка проекта).
# Если не заполнено - письма не отправляются, только логируются (см. src/api/email_sender.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@searchpro.local
